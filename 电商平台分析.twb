      <aliases enabled='yes' />
      <column caption='AnnualIncome客户的年收入' datatype='real' name='[AnnualIncome]' role='measure' type='quantitative' />
      <column caption='转化率' datatype='real' name='[Calculation_1262014771421184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [PurchaseStatus]=1 THEN 1 ELSE 0 END)/COUNT([PurchaseStatus])' />
      </column>
      <column caption='年龄分组' datatype='string' name='[Calculation_1689724475158531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt; 25 THEN &apos;18-24岁&apos;&#13;&#10;ELSEIF [Age] &lt; 35 THEN &apos;25-34岁&apos;&#13;&#10;ELSEIF [Age] &lt; 45 THEN &apos;35-44岁&apos;&#13;&#10;ELSEIF [Age] &lt; 55 THEN &apos;45-54岁&apos;&#13;&#10;ELSE &apos;55岁及以上&apos;&#13;&#10;END' />
      </column>
      <column caption='年收入分组' datatype='string' name='[Calculation_1689724475293701]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [AnnualIncome] &lt; 40000 THEN &apos;低收入(&lt;4万)&apos;&#13;&#10;ELSEIF [AnnualIncome] &lt; 70000 THEN &apos;中低收入(4-7万)&apos;&#13;&#10;ELSEIF [AnnualIncome] &lt; 100000 THEN &apos;中等收入(7-10万)&apos;&#13;&#10;ELSEIF [AnnualIncome] &lt; 150000 THEN &apos;中高收入(10-15万)&apos;&#13;&#10;ELSE &apos;高收入(&gt;15万)&apos;&#13;&#10;END' />
      </column>
      <column caption='网站停留时长分组' datatype='string' name='[Calculation_1689724475383814]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [TimeSpentOnWebsite] &lt; 3 THEN &apos;短停留(&lt;3分钟)&apos;&#13;&#10;ELSEIF [TimeSpentOnWebsite] &lt; 8 THEN &apos;中停留(3-8分钟)&apos;&#13;&#10;ELSE &apos;长停留(&gt;8分钟)&apos;&#13;&#10;END' />
      </column>
      <column caption='连续停留时间数据桶' datatype='integer' name='[Calculation_1806274432483328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOOR([TimeSpentOnWebsite]/3)*3' />
      </column>
      <column caption='Customer Satisfaction满意度评分' datatype='integer' name='[CustomerSatisfaction]' role='measure' type='quantitative' />
      <column caption='CustomerSegment企业定义的客户分类' datatype='string' name='[CustomerSegment]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Premium&quot;' value='高级会员' />
          <alias key='&quot;Regular&quot;' value='普通会员' />
          <alias key='&quot;VIP&quot;' value='VIP会员' />
        </aliases>
      </column>
      <column caption='Customer Tenure Years客户加入平台的时长' datatype='real' name='[CustomerTenureYears]' role='measure' type='quantitative' />
      <column caption='Discounts Availed使用的优惠券数量' datatype='integer' name='[DiscountsAvailed]' role='measure' type='quantitative' />
      <column datatype='string' name='[Gender]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Female&quot;' value='女性' />
          <alias key='&quot;Male&quot;' value='男性' />
        </aliases>
      </column>
      <column caption='Last Purchase Days Ago距离客户最近一次购买的天数' datatype='integer' name='[LastPurchaseDaysAgo]' role='measure' type='quantitative' />
      <column caption='Loyalty Program是否加入忠诚度计划' datatype='integer' name='[LoyaltyProgram]' role='measure' type='quantitative' />
      <column caption='Number Of Purchases客户的总购买次数' datatype='integer' name='[NumberOfPurchases]' role='measure' type='quantitative' />
      <column caption='Preferred Device客户最常使用的设备' datatype='string' name='[PreferredDevice]' role='dimension' type='nominal' />
      <column caption='Product Category客户最常购买的产品类别' datatype='string' name='[ProductCategory]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;Electronics&quot;' value='电子产品' />
          <alias key='&quot;Fashion&quot;' value='时尚产品' />
          <alias key='&quot;Furniture&quot;' value='家具' />
          <alias key='&quot;Groceries&quot;' value='杂货' />
          <alias key='&quot;Kitchen&quot;' value='厨房用品' />
        </aliases>
      </column>
      <column caption='Purchase Status购买是否成功' datatype='integer' name='[PurchaseStatus]' role='measure' type='quantitative' />
      <column caption='Referral Source发现该平台的途径' datatype='string' name='[ReferralSource]' role='dimension' type='nominal'>
        <aliases>
